<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Snapsearch.Views.ResultsPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pancakeView="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:viewModels="clr-namespace:Snapsearch.ViewModels;assembly=Snapsearch">
    <!--  todo - fix layout properties  -->
    <!--  Implement MainViewModel in the page  -->
    <ContentPage.BindingContext>
        <viewModels:ResultsPageViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Content>
        <AbsoluteLayout>
            <!--  Elements that are not results  -->
            <!--  Logo image  -->
            <ImageButton
                x:Name="LogoImage"
                AbsoluteLayout.LayoutBounds="10,10"
                BackgroundColor="Transparent"
                Source="snapsearch_logo" />
            <!--  The image that was searched  -->
            <Image x:Name="GenericImage"/>
            <Image x:Name="PickedImage"/>
            <!--  Text for informing the user with the amount of search results  -->
            <Label x:Name="TextLabel" Text="We found 10 images" />
            <ScrollView
                x:Name="ScrollContainer"
                AbsoluteLayout.LayoutBounds="20, 220, 350, 400"
                BackgroundColor="Transparent">
                <Grid>

                    <FlexLayout
                        x:Name="ResultFlexLayout"
                        BindableLayout.ItemsSource="{Binding Images}"
                        Direction="Row"
                        HeightRequest="1020"
                        JustifyContent="SpaceAround"
                        WidthRequest="500"
                        Wrap="Wrap">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <pancakeView:PancakeView
                                    Margin="3"
                                    BackgroundColor="White"
                                    CornerRadius="10"
                                    HeightRequest="200"
                                    VerticalOptions="Center"
                                    WidthRequest="170">
                                    <Grid>
                                        <!--    -->
                                        <Image
                                            x:Name="ProductImage"
                                            Margin="3"
                                            HeightRequest="200"
                                            HorizontalOptions="Center"
                                            InputTransparent="True"
                                            Source="{Binding ImageUrl}"
                                            VerticalOptions="Start"
                                            WidthRequest="170" />
                                        <StackLayout>
                                            <Label
                                                Margin="20,120"
                                                FontSize="10"
                                                Text="{Binding ImageName}" />
                                        </StackLayout>
                                    </Grid>
                                </pancakeView:PancakeView>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </Grid>
            </ScrollView>
        </AbsoluteLayout>
    </ContentPage.Content>
</ContentPage>


