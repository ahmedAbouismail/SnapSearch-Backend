<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Snapsearch.Views.ChoosingPhotoPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Pick an Image">
    <ContentPage.Content>
        <Grid
            BackgroundColor="Transparent"
            ColumnDefinitions="*, 50, 50, *"
            RowDefinitions="*,AUTO">
            <Image
                x:Name="LogoImage"
                Grid.Row="0"
                Grid.ColumnSpan="4"
                HeightRequest="20"
                HorizontalOptions="Center"
                Source="snapsearch_logo_text"
                VerticalOptions="Start" />
            <Label
                x:Name="Hint"
                Grid.Row="0"
                Grid.ColumnSpan="4"
                HorizontalOptions="Center"
                Text="Capture a photo or pick an image from your gallery"
                VerticalOptions="Center" />
            <Image
                x:Name="PickedImage"
                Grid.Row="0"
                Grid.ColumnSpan="4" />
            <Grid
                Grid.Row="1"
                Grid.ColumnSpan="4"
                BackgroundColor="Transparent"
                ColumnDefinitions="130,70,70,130"
                HorizontalOptions="CenterAndExpand"
                RowDefinitions="100"
                VerticalOptions="End">
                <Frame
                    Grid.ColumnSpan="4"
                    HeightRequest="120"
                    WidthRequest="120">
                    <Frame.Background>
                        <!--  StartPoint defaults to (0,0)  -->
                        <LinearGradientBrush EndPoint="0,1">
                            <GradientStop Offset="0.1" Color="Transparent" />
                            <GradientStop Offset="1.0" Color="Gray" />
                        </LinearGradientBrush>
                    </Frame.Background>
                </Frame>

                <ImageButton
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="10"
                    BackgroundColor="Transparent"
                    Clicked="ImageButton_OnClicked"
                    Source="snapsearch_button_gallery.png" />
                <ImageButton
                    x:Name="TakePhoto"
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="10"
                    BackgroundColor="Transparent"
                    Clicked="TakePhoto_OnClicked"
                    Source="snapsearch_button_camera" />
                <ImageButton
                    x:Name="UsePhoto"
                    Grid.Row="0"
                    Grid.Column="3"
                    BackgroundColor="Transparent"
                    HeightRequest="45"
                    HorizontalOptions="End"
                    IsVisible="False"
                    Source="snapsearch_button_usephoto"
                    TranslationX="-20" 
                    Clicked="UsePhoto_OnClicked"/>
            </Grid>
            <!--<Button
                BackgroundColor="PaleTurquoise"
                Clicked="UploadPhoto_Clicked"
                FontSize="30"
                Text="Upload Photo (DONT CLICK)"
                TextColor="LightSkyBlue" />-->

        </Grid>

    </ContentPage.Content>
</ContentPage>